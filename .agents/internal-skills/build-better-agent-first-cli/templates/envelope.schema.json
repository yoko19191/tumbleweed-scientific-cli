{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-tumbleweed.dev/schemas/agent-first-cli/envelope-1.json",
  "$comment": "Internal development template; not distributed with public Tumbleweed Skills.",
  "title": "Agent-first CLI envelope",
  "type": "object",
  "required": ["schema_version", "ok", "meta"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "data": {},
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": {},
        "repair_hint": { "type": "string" }
      },
      "additionalProperties": true
    },
    "meta": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "request_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } } },
      "then": { "required": ["data"], "not": { "required": ["error"] } }
    },
    {
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"], "not": { "required": ["data"] } }
    }
  ],
  "additionalProperties": false
}
